# Split-mode gateway: routes each /api/v1 prefix to the service that owns it (see the ownership
# table in docs/ARCHITECTURE.md). Internal routes never leave the network.
# When a later phase adds a service, add its matcher here; put more specific paths (for example
# /api/v1/unit-groups/*/overbooking, owned by reservation) in a handle block above the broader one.
{
	admin off
	auto_https off
}

:8090 {
	handle /internal/* {
		respond 404
	}

	# Inventory owns the minibar check on a booking; it sits above any broader /bookings matcher.
	@inventory path /api/v1/stock/* /api/v1/bookings/*/minibar-checks
	handle @inventory {
		reverse_proxy inventory:8080
	}

	@maintenance path /api/v1/work-orders /api/v1/work-orders/* /api/v1/assets /api/v1/assets/* /api/v1/vendors /api/v1/vendors/* /api/v1/preventive-plans /api/v1/preventive-plans/*
	handle @maintenance {
		reverse_proxy maintenance:8080
	}

	@identity path /api/v1/auth/* /api/v1/users /api/v1/users/* /api/v1/permissions /api/v1/permissions/* /api/v1/audit /api/v1/me /api/v1/health /api/v1/docs/*
	handle @identity {
		reverse_proxy identity:8080
	}

	# Companions hang off a booking path but belong to guest; keep this above reservation's bookings.
	@guest path /api/v1/guests /api/v1/guests/* /api/v1/stay-companions /api/v1/stay-companions/* /api/v1/bookings/*/companions /api/v1/foreign-reports /api/v1/foreign-guests /api/v1/lost-found /api/v1/lost-found/*
	handle @guest {
		reverse_proxy guest:8080
	}

	# Reservation owns one path under unit-groups; keep this above property.
	@reservation path /api/v1/bookings /api/v1/bookings/* /api/v1/booking-groups /api/v1/booking-groups/* /api/v1/stay-restrictions /api/v1/stay-restrictions/* /api/v1/overbooking-policies /api/v1/walks /api/v1/pre-checkins /api/v1/checkin/* /api/v1/unit-groups/*/overbooking
	handle @reservation {
		reverse_proxy reservation:8080
	}

	@services path /api/v1/menu-items /api/v1/menu-items/* /api/v1/service-partners /api/v1/service-partners/* /api/v1/service-orders /api/v1/service-orders/* /api/v1/order/* /api/v1/service-requests /api/v1/service-requests/*
	handle @services {
		reverse_proxy services:8080
	}

	@property path /api/v1/locations /api/v1/locations/* /api/v1/villas /api/v1/villas/* /api/v1/properties /api/v1/unit-groups /api/v1/unit-groups/* /api/v1/units /api/v1/units/* /api/v1/rate-plans /api/v1/unit-blocks /api/v1/unit-blocks/* /api/v1/facilities
	handle @property {
		reverse_proxy property:8080
	}

	@people path /api/v1/employees /api/v1/employees/* /api/v1/shifts /api/v1/shift-assignments /api/v1/attendance /api/v1/leave-requests /api/v1/leave-requests/* /api/v1/overtime-requests /api/v1/overtime-requests/* /api/v1/loans /api/v1/loans/* /api/v1/announcements /api/v1/announcements/* /api/v1/kpi-reviews /api/v1/kpi-reviews/*
	handle @people {
		reverse_proxy people:8080
	}

	@payroll path /api/v1/payroll/*
	handle @payroll {
		reverse_proxy payroll:8080
	}

	@channel path /api/v1/airbnb-accounts /api/v1/airbnb-accounts/* /api/v1/airbnb-listings /api/v1/airbnb-listings/* /api/v1/enquiries /api/v1/enquiries/* /api/v1/public/*
	handle @channel {
		reverse_proxy channel:8080
	}

	handle {
		header Content-Type application/json
		respond `{"error":{"code":"NOT_IMPLEMENTED","message":"No service owns this route yet."}}` 501
	}
}
