# Split-mode gateway: routes each /api/v1 prefix to the service that owns it (see the ownership
# table in docs/ARCHITECTURE.md). Internal routes never leave the network.
# When a later phase adds a service, add its matcher here; put more specific paths (for example
# /api/v1/unit-groups/*/overbooking, owned by reservation) in a handle block above the broader one.
{
	admin off
	auto_https off
}

:8090 {
	handle /internal/* {
		respond 404
	}

	@identity path /api/v1/auth/* /api/v1/users /api/v1/users/* /api/v1/permissions /api/v1/permissions/* /api/v1/audit /api/v1/me /api/v1/health /api/v1/docs/*
	handle @identity {
		reverse_proxy identity:8080
	}

	@property path /api/v1/locations /api/v1/locations/* /api/v1/villas /api/v1/villas/* /api/v1/properties /api/v1/unit-groups /api/v1/unit-groups/* /api/v1/units /api/v1/units/* /api/v1/rate-plans /api/v1/unit-blocks /api/v1/unit-blocks/* /api/v1/facilities
	handle @property {
		reverse_proxy property:8080
	}

	@channel path /api/v1/airbnb-accounts /api/v1/airbnb-accounts/* /api/v1/airbnb-listings /api/v1/airbnb-listings/* /api/v1/enquiries /api/v1/enquiries/* /api/v1/public/*
	handle @channel {
		reverse_proxy channel:8080
	}

	handle {
		header Content-Type application/json
		respond `{"error":{"code":"NOT_IMPLEMENTED","message":"No service owns this route yet."}}` 501
	}
}
